PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.up.railway.app

# Database (PostgreSQL + Prisma)
DATABASE_URL=

# Authentication & Security
JWT_SECRET=
INITIAL_ADMIN_EMAIL=admin@lifeos.com
INITIAL_ADMIN_PASSWORD=

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LifeOS System <no-reply@yourdomain.com>"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lifeos-uploads
R2_PUBLIC_URL=

# Web Push VAPID Configuration (HTTPS Port 443 - Railway Free & PWA)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@lifeos.app

# Facebook Messenger Bot (HTTPS Port 443)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=lifeos_messenger_verify_2026
FB_APP_SECRET=
