# =====================================================================
# LifeOS Production Environment Configuration Template
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy
# =====================================================================

# Server & Network Settings
PORT=3000
NODE_ENV=production
APP_URL=https://yourdomain.com

# Database Connection (PostgreSQL 14+ hoặc Neon Cloud PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/lifeos?schema=public&sslmode=prefer"

# Authentication & JWT Security (BẮT BUỘC tạo chuỗi ngẫu nhiên tối thiểu 64 ký tự trên VPS)
# Có thể sinh bằng: openssl rand -base64 48
JWT_SECRET=super_secret_jwt_key_at_least_64_characters_long_for_security_production

# Tài khoản Admin khởi tạo lần đầu
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=AdminStrongPassword!2026

# =====================================================================
# GMAIL SMTP NOTIFICATION ENGINE (100% Guaranteed Delivery)
# =====================================================================
# Lưu ý: Cần bật 2FA trên tài khoản Google và tạo "Mật khẩu ứng dụng" (App Password 16 ký tự)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="LifeOS System <your_email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Tùy chọn: Dự phòng kênh gửi mail thứ 2 qua Resend API (nếu Gmail SMTP bị nghẽn mạng VPS)
RESEND_API_KEY=

# =====================================================================
# Google OAuth 2.0 / OpenID Connect (Đăng nhập bằng tài khoản Google)
# =====================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# =====================================================================
# Cloudflare R2 / AWS S3 Object Storage (Lưu trữ ảnh & file đính kèm)
# =====================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lifeos-uploads
R2_PUBLIC_URL=https://assets.yourdomain.com
