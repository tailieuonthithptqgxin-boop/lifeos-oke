{
  "name": "react-example",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "build:server": "esbuild src/backend/serverMain.ts --bundle --platform=node --format=esm --packages=external --target=esnext --outfile=dist/server.mjs",
    "build": "prisma generate && node --max-old-space-size=2048 ./node_modules/vite/bin/vite.js build && node -e \"import('fs').then(fs=>fs.rmSync('dist/_redirects',{force:true}))\" && npm run build:server",
    "cloudflare:types": "npx wrangler types",
    "cloudflare:dry-run": "npx wrangler deploy --dry-run",
    "cloudflare:deploy": "npx wrangler deploy --env=production",
    "cloudflare:preview": "npx wrangler deploy --env=preview",
    "cloudflare:pages": "npx wrangler pages deploy dist",
    "start": "node dist/server.mjs",
    "lint": "tsc --noEmit",
    "test:smoke": "tsx --test tests/zero_regression_smoke.test.ts",
    "check-all": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\" --rule react-hooks/rules-of-hooks:error && tsx --test tests/zero_regression_smoke.test.ts && vite build",
    "admin:create": "tsx scripts/create_admin.ts",
    "test": "tsx --test tests/**/*.test.*",
    "test:live": "tsx --test tests/live_system_e2e.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@electric-sql/pglite": "^0.5.8",
    "@prisma/client": "^6.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/gsap": "^1.20.2",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-gateway": "^0.3.0-beta.4",
    "postprocessing": "^6.39.5",
    "prisma": "^6.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "tsx": "^4.21.0",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "three": "^0.186.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
