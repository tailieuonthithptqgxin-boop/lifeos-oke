# Server Config
PORT=3000
NODE_ENV=production
APP_URL=https://yourdomain.com

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://lifeos_user:YOUR_STRONG_DB_PASSWORD@localhost:5432/lifeos_db?schema=public"

# Authentication & Security
JWT_SECRET=your_super_strong_random_jwt_secret_min_32_characters
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your_initial_admin_password_min_10_chars

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LifeOS System <no-reply@yourdomain.com>"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lifeos-uploads
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
